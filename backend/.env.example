# Copy to .env and adjust for your machine. Never commit the real .env.

# --- PostgreSQL ---
POSTGRES_USER=admin_owner
POSTGRES_PASSWORD=admin_dev_password
POSTGRES_DB=platform_admin
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PASSWORD=admin_dev_password
REDIS_PORT=6380

# --- backend (`cargo run`) ---
# Used when running the backend directly against the compose stack's
# Postgres/Redis on localhost. Must match the credentials above. Binds
# 8081 so it doesn't clash with the tenant platform's backend on 8080.
DATABASE_URL=postgres://admin_owner:admin_dev_password@localhost:5433/platform_admin
REDIS_URL=redis://:admin_dev_password@localhost:6380
# Redis holds the rate-limit counters (sign-in attempts, PIN lookups).
# Leave REDIS_URL empty to run without limits. Set TRUST_PROXY=true only
# behind a load balancer that appends the caller's address to
# X-Forwarded-For; otherwise anyone could fake their address.
TRUST_PROXY=false

# --- Email ---
# Password-reset and invitation links go out over SMTP, e.g.
#   SMTP_URL=smtps://USER:PASS@email-smtp.us-east-1.amazonaws.com
# Leave SMTP_URL empty and emails are written to the log instead (handy
# locally: the link is right there). MAIL_FROM is required with SMTP_URL.
SMTP_URL=
MAIL_FROM="Platform <no-reply@example.com>"
# Where people open the app; links in emails point here.
PUBLIC_URL=http://localhost:8081
BIND_ADDR=0.0.0.0:8081
RUST_LOG=info

# --- Super user ---
# The first account of the master tenant, created on startup if no user
# has this email yet, so a fresh database has someone who can sign in.
# Password must be at least 12 characters. Changing it later has no effect
# on an existing user. Unset both to skip.
SUPER_USER_EMAIL=admin@platform.local
SUPER_USER_PASSWORD=change-me-please

# --- Calling tenants ---
# Ed25519 private key admin signs its calls to tenant deployments with:
# 32 random bytes, base64url without padding. Generate one with
#   openssl genpkey -algorithm ed25519 -outform DER | tail -c 32 | basenc --base64url | tr -d '='
# On startup admin logs the matching public key; every tenant gets that as
# ADMIN_PUBLIC_KEY. Leave empty and admin can't push changes to tenants.
ADMIN_SIGNING_KEY=

# --- Image build ---
# Where the frontend's npm packages are downloaded from while building the
# image. Some networks block registry.npmjs.org; a mirror works the same,
# since every package is checked against package-lock.json.
NPM_REGISTRY=https://registry.npmjs.org
# NPM_REGISTRY=https://registry.npmmirror.com

# --- app container (compose.yaml's `app` service only) ---
# Host port the bundled image is published on. The `app` service builds
# its own DATABASE_URL/REDIS_URL pointing at the `postgres`/`redis`
# service hostnames, so the two URLs above don't apply to it.
APP_PORT=8081
